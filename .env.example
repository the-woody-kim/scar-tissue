# MongoDB Atlas — the Hackathon Sandbox cluster (required to be a finalist)
MONGODB_URI=
MONGODB_DB=scar_tissue

# OpenRouter — the credit code arrives from 10:30 on 09-26; use a personal key before that
OPENROUTER_API_KEY=
# fast model with tool calling — confirm the slug on openrouter.ai/models
EXECUTOR_MODEL=
# strong model with JSON-schema output
PROPOSER_MODEL=

# atlas = Automated Embeddings (if the sandbox tier has it) · voyage = the Voyage AI API
EMBEDDINGS=atlas
# only when EMBEDDINGS=voyage (200M free tokens for the event)
VOYAGE_API_KEY=

# live = call models · record = call and save fixtures · replay = serve fixtures (UI shows REPLAY)
LLM_MODE=live
EVAL_CONCURRENCY=8

# LangSmith tracing — beats, evals, proposals and every model call as one trace tree (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=scar-tissue
